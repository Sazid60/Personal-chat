<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#030712">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>NEXUS // Quantum Comms</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon-192.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Ambient Cyber Background -->
  <div class="cyber-grid-bg"></div>

  <!-- Auth Screen -->
  <div id="auth-modal" class="screen-modal active">
    <div class="card auth-card">
      <div class="brand">
        <div class="brand-icon-wrapper">
          <i class="fa-solid fa-atom brand-icon"></i>
          <div class="ring-orbit"></div>
        </div>
        <h2>NEXUS // OS</h2>
        <p class="brand-sub">QUANTUM END-TO-END ENCRYPTED COMMS</p>
      </div>

      <!-- Auth Tabs -->
      <div class="auth-tabs">
        <button type="button" id="tab-login" class="auth-tab-btn active">Terminal Access</button>
        <button type="button" id="tab-register" class="auth-tab-btn">Register Node</button>
      </div>

      <!-- Login Form -->
      <form id="form-login" class="auth-form">
        <div class="form-group">
          <label><i class="fa-solid fa-terminal"></i> Identity / Comm ID (Email or Phone)</label>
          <input type="text" id="login-identifier" placeholder="operator@nexus.net or +123456789" required autocomplete="username">
        </div>
        <div class="form-group">
          <label><i class="fa-solid fa-fingerprint"></i> Neural Keyphrase / Password</label>
          <input type="password" id="login-password" placeholder="Enter secure key" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block">
          <i class="fa-solid fa-power-off"></i> Authenticate Uplink
        </button>
      </form>

      <!-- Register Form -->
      <form id="form-register" class="auth-form hidden">
        <div class="form-group">
          <label><i class="fa-solid fa-user-astronaut"></i> Operative Handle / Name</label>
          <input type="text" id="reg-name" placeholder="e.g. Commander Vane" required autocomplete="name">
        </div>
        <div class="form-group">
          <label><i class="fa-solid fa-at"></i> Comm Frequency (Email)</label>
          <input type="email" id="reg-email" placeholder="vane@nexus.net" required autocomplete="email">
        </div>
        <div class="form-group">
          <label><i class="fa-solid fa-satellite"></i> Comms Band (Phone)</label>
          <input type="tel" id="reg-phone" placeholder="+1234567890" required autocomplete="tel">
        </div>
        <div class="form-group">
          <label><i class="fa-solid fa-shield-halved"></i> Master Cipher Key (Password)</label>
          <input type="password" id="reg-password" placeholder="Create master key" required autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block">
          <i class="fa-solid fa-microchip"></i> Initialize Node
        </button>
      </form>
    </div>
  </div>

  <!-- Main Cyber Comms Layout -->
  <div id="main-layout" class="whatsapp-layout hidden">
    <!-- Left Navigation Sidebar -->
    <aside class="sidebar">
      <!-- Profile Header -->
      <header class="sidebar-header">
        <div class="user-profile">
          <div class="avatar" id="my-avatar"><i class="fa-solid fa-user-astronaut"></i></div>
          <div class="user-meta">
            <span class="user-name" id="my-name">Operative</span>
            <span class="user-status-text">NODE ONLINE</span>
          </div>
        </div>
        <div class="header-tools">
          <button id="btn-open-new-chat" class="tool-icon-btn" title="Initiate Node Uplink"><i class="fa-solid fa-plus"></i></button>
          <button id="btn-logout" class="tool-icon-btn text-danger" title="Sever Uplink"><i class="fa-solid fa-power-off"></i></button>
        </div>
      </header>

      <!-- Global Search Bar -->
      <div class="search-bar-wrapper">
        <div class="search-box">
          <i class="fa-solid fa-radar"></i>
          <input type="text" id="global-search-input" placeholder="Scan nodes by frequency or identity...">
        </div>
      </div>

      <!-- Search Results Dropdown -->
      <div id="search-results-panel" class="search-results-panel hidden">
        <div class="search-results-header"><i class="fa-solid fa-satellite-dish"></i> Discovered Nodes</div>
        <div id="search-results-list" class="search-results-list"></div>
      </div>

      <!-- Active Frequencies (Conversations) List -->
      <div class="conversations-list" id="conversations-list"></div>
    </aside>

    <!-- Right Pane: Active Tactical Chat -->
    <main class="chat-main" id="chat-main">
      <!-- Empty State -->
      <div id="no-chat-screen" class="empty-chat-screen">
        <div class="empty-content">
          <div class="holo-icon-ring">
            <i class="fa-solid fa-satellite-dish empty-icon"></i>
          </div>
          <h2>NEURAL COMMS DECK</h2>
          <p>Quantum cryptographic handshake ready. Scan or initialize a communication node to stream encrypted telemetry and audio/video uplinks.</p>
          <button id="btn-start-chat-prompt" class="btn btn-primary"><i class="fa-solid fa-crosshairs"></i> Locate Node</button>
        </div>
      </div>

      <!-- Active Chat View -->
      <div id="active-chat-screen" class="active-chat-screen hidden">
        <!-- Top Chat Header -->
        <header class="chat-header">
          <div class="chat-peer-info">
            <button id="btn-back-to-sidebar" class="tool-icon-btn mobile-only" title="Back to deck"><i class="fa-solid fa-arrow-left"></i></button>
            <div class="avatar-wrapper">
              <div class="avatar" id="active-peer-avatar"><i class="fa-solid fa-user-shield"></i></div>
              <span class="status-indicator" id="active-peer-status-dot"></span>
            </div>
            <div class="peer-text">
              <h3 id="active-peer-name">Node Identity</h3>
              <span id="active-peer-status" class="peer-status">SYNCHRONIZING</span>
            </div>
          </div>

          <div class="chat-header-actions">
            <button id="btn-toggle-search" class="action-btn" title="Scan Telemetry Data"><i class="fa-solid fa-magnifying-glass"></i></button>
            <button id="btn-start-audio-call" class="action-btn call-btn" title="Audio Uplink"><i class="fa-solid fa-headset"></i></button>
            <button id="btn-start-video-call" class="action-btn call-btn" title="Hologram Video Stream"><i class="fa-solid fa-video"></i></button>
            <button id="btn-delete-chat" class="action-btn text-danger" title="Purge Frequency Logs"><i class="fa-solid fa-trash-can"></i></button>
          </div>
        </header>

        <!-- In-Chat Search Bar -->
        <div id="in-chat-search-bar" class="in-chat-search-bar hidden">
          <i class="fa-solid fa-radar"></i>
          <input type="text" id="in-chat-search-input" placeholder="Query transmission log history...">
          <span id="search-match-count" class="match-count">0/0</span>
          <button id="btn-search-prev" class="btn-search-nav" title="Previous packet"><i class="fa-solid fa-chevron-up"></i></button>
          <button id="btn-search-next" class="btn-search-nav" title="Next packet"><i class="fa-solid fa-chevron-down"></i></button>
          <button id="btn-close-search" class="btn-search-close" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <!-- Chat Messages Area -->
        <div class="chat-messages-viewport" id="messages-viewport">
          <div id="history-loader" class="history-loader hidden">
            <i class="fa-solid fa-circle-notch fa-spin"></i> RETRIEVING EARLIER PACKETS...
          </div>
          <div id="messages-container" class="messages-flow"></div>
        </div>

        <!-- Typing Indicator -->
        <div id="typing-indicator" class="typing-bar hidden">
          <span id="typing-text">Node transmitting telemetry...</span>
          <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>

        <!-- Futuristic Command Input Bar -->
        <footer class="chat-input-bar">
          <input type="file" id="file-input-media" accept="image/*,video/*" class="hidden">
          <input type="file" id="file-input-all" class="hidden">

          <div class="input-actions-left">
            <button type="button" id="btn-attach" class="tool-btn" title="Attach Data Stream"><i class="fa-solid fa-paperclip"></i></button>
            <button type="button" id="btn-gif" class="tool-btn" title="Holocubes / GIFs"><i class="fa-solid fa-cube"></i></button>
            <button type="button" id="btn-record-audio" class="tool-btn" title="Voice Transmission"><i class="fa-solid fa-microphone-lines"></i></button>
          </div>

          <!-- Attachment Dropdown -->
          <div id="attach-menu" class="attach-dropdown hidden">
            <button id="opt-send-media"><i class="fa-solid fa-photo-film"></i> Visual Feed / Video</button>
            <button id="opt-send-file"><i class="fa-solid fa-hard-drive"></i> Encrypted Data Packet</button>
          </div>

          <div class="text-input-wrapper">
            <textarea id="message-input" placeholder="Transmit encrypted packet..." rows="1"></textarea>
          </div>

          <div class="input-actions-right">
            <button type="button" id="btn-send-message" class="btn-send" title="Dispatch Packet"><i class="fa-solid fa-paper-plane"></i></button>
          </div>
        </footer>
      </div>
    </main>
  </div>

  <!-- New Chat / Node Discovery Modal -->
  <div id="new-chat-modal" class="modal-backdrop hidden">
    <div class="card new-chat-card">
      <div class="modal-header">
        <h3><i class="fa-solid fa-satellite"></i> Connect Remote Node</h3>
        <button id="btn-close-new-chat" class="icon-close"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <label>Node Frequency, Email, or Operative Identifier:</label>
        <div class="input-with-button">
          <input type="text" id="new-chat-search-input" placeholder="e.g. +123456789 or agent@nexus.net">
          <button type="button" id="btn-search-users" class="btn btn-primary"><i class="fa-solid fa-crosshairs"></i> Lock Node</button>
        </div>
        <div id="new-chat-results" class="new-chat-results">
          <p class="hint-text">Input parameters to triangulate network operative.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Call Screen Overlay -->
  <div id="call-overlay" class="call-overlay hidden">
    <div class="call-container">
      <div class="call-top-bar">
        <span class="call-timer" id="call-timer">00:00</span>
        <span class="call-type-badge" id="call-type-indicator"><i class="fa-solid fa-headset"></i> Neural Audio Stream</span>
      </div>

      <div class="video-grid" id="video-grid">
        <div class="video-box remote-box" id="remote-video-container">
          <video id="remote-video" autoplay playsinline></video>
          <div class="audio-avatar" id="remote-audio-avatar">
            <i class="fa-solid fa-user-astronaut"></i>
            <div class="pulse-ring"></div>
            <div class="pulse-ring secondary"></div>
          </div>
          <span class="video-label" id="remote-user-label">REMOTE NODE</span>
        </div>

        <div class="video-box local-box" id="local-video-container">
          <video id="local-video" autoplay playsinline muted></video>
          <div class="audio-avatar small" id="local-audio-avatar"><i class="fa-solid fa-user-astronaut"></i></div>
          <span class="video-label">LOCAL UPLINK</span>
        </div>
      </div>

      <div class="call-controls">
        <button id="btn-call-mute" class="ctrl-btn" title="Toggle Audio Transceiver"><i class="fa-solid fa-microphone-lines"></i></button>
        <button id="btn-call-video" class="ctrl-btn" title="Toggle Optical Feed"><i class="fa-solid fa-video"></i></button>
        <button id="btn-call-screen" class="ctrl-btn" title="Stream Display Buffer"><i class="fa-solid fa-display"></i></button>
        <button id="btn-call-hangup" class="ctrl-btn btn-hangup" title="Terminate Frequency"><i class="fa-solid fa-phone-slash"></i></button>
      </div>
    </div>
  </div>

  <!-- Incoming Call Modal -->
  <div id="incoming-call-modal" class="modal-backdrop hidden">
    <div class="card call-alert-card">
      <div class="caller-avatar pulse-anim"><i class="fa-solid fa-satellite-dish"></i></div>
      <h3 id="incoming-caller-name">Remote Operative</h3>
      <p id="incoming-call-text">Incoming neural uplink request...</p>
      <div class="modal-actions">
        <button id="btn-decline-call" class="btn btn-danger"><i class="fa-solid fa-ban"></i> Reject</button>
        <button id="btn-accept-call" class="btn btn-success"><i class="fa-solid fa-check"></i> Bridge Channel</button>
      </div>
    </div>
  </div>

  <!-- GIF Picker Modal -->
  <div id="gif-modal" class="modal-backdrop hidden">
    <div class="card gif-card">
      <div class="gif-header">
        <h3><i class="fa-solid fa-cube"></i> Neural Holocubes</h3>
        <button id="btn-close-gif" class="icon-close"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="gif-search-bar">
        <input type="text" id="gif-search-input" placeholder="Search holocube feeds...">
      </div>
      <div class="gif-results" id="gif-grid"></div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="modal-backdrop hidden">
    <div class="lightbox-content">
      <button id="btn-close-lightbox" class="lightbox-close"><i class="fa-solid fa-xmark"></i></button>
      <img id="lightbox-img" src="" alt="Holofeed">
    </div>
  </div>

  <!-- Toast Element -->
  <div id="toast" class="toast hidden"></div>

  <!-- Audio sounds -->
  <audio id="audio-ringtone" loop src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="none"></audio>

  <script src="/socket.io/socket.io.js"></script>
  <script src="webrtc.js"></script>
  <script src="app.js"></script>
</body>
</html>
