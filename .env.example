# ==============================================================================
# NEXUS // Quantum Comms - Environment Configuration Template
# ==============================================================================

# Turso Cloud libSQL / SQLite Database URL
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"

# Turso Database JWT Authentication Token (Read/Write Access)
TURSO_AUTH_TOKEN="your-turso-auth-token"

# JSON Web Token Secret Key (used to sign & verify operative authentication tokens)
JWT_SECRET="your-jwt-secret-key"

# Local Server Port (Render sets this dynamically via process.env.PORT)
PORT=3000
